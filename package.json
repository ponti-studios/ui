{
  "name": "@ponti-studios/ui",
  "version": "0.6.0",
  "private": false,
  "description": "Shared UI component library for Ponti Studios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponti-studios/ui.git"
  },
  "files": [
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/styles/index.css",
    "./src/styles/animations.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./primitives": {
      "types": "./src/components/primitives/index.ts",
      "import": "./src/components/primitives/index.ts"
    },
    "./forms": {
      "types": "./src/components/forms/index.ts",
      "import": "./src/components/forms/index.ts"
    },
    "./feedback": {
      "types": "./src/components/feedback/index.ts",
      "import": "./src/components/feedback/index.ts"
    },
    "./filters": {
      "types": "./src/components/filters/index.ts",
      "import": "./src/components/filters/index.ts"
    },
    "./overlays": {
      "types": "./src/components/overlays/index.ts",
      "import": "./src/components/overlays/index.ts"
    },
    "./navigation": {
      "types": "./src/components/navigation/index.ts",
      "import": "./src/components/navigation/index.ts"
    },
    "./data-display": {
      "types": "./src/components/data-display/index.ts",
      "import": "./src/components/data-display/index.ts"
    },
    "./layout": {
      "types": "./src/components/layout/index.ts",
      "import": "./src/components/layout/index.ts"
    },
    "./utilities": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    },
    "./tokens": {
      "types": "./src/styles/tokens/index.ts",
      "import": "./src/styles/tokens/index.ts"
    },
    "./tokens/css-vars": {
      "types": "./src/styles/tokens/css-vars.ts",
      "import": "./src/styles/tokens/css-vars.ts"
    },
    "./native": {
      "types": "./src/native/index.ts",
      "import": "./src/native/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./animations.css": "./src/styles/animations.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "vite",
    "storybook": "style-dictionary build --config src/styles/tokens/style-dictionary.dark-storybook.json && storybook dev -p 6006",
    "check:source": "node src/styles/tokens/scripts/check-source.mjs",
    "test": "vitest --run --config vitest.config.ts",
    "test:a11y": "vitest --run --config vitest.config.ts",
    "tokens:build": "style-dictionary build --config src/styles/tokens/style-dictionary.foundations.json && style-dictionary build --config src/styles/tokens/style-dictionary.light.json && style-dictionary build --config src/styles/tokens/style-dictionary.dark.json && style-dictionary build --config src/styles/tokens/style-dictionary.dark-storybook.json",
    "tokens:check": "pnpm run tokens:build && node src/styles/tokens/scripts/check-foundations.mjs && git diff --exit-code -- src/styles/tokens/generated",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --fix",
    "format": "oxfmt src --write",
    "prepack": "pnpm run tokens:check && pnpm run check:source && pnpm run typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/colors": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.24.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-links": "^10.5.3",
    "@storybook/addon-onboarding": "^10.5.3",
    "@storybook/addon-themes": "10.5.3",
    "@storybook/addon-vitest": "10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "^1.74.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-native": "0.86.0",
    "storybook": "^10.5.3",
    "style-dictionary": "5.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.10.0"
}
