{
  "name": "@ponti-studios/ui",
  "version": "3.0.0",
  "private": false,
  "description": "Shared UI component library for Ponti Studios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponti-studios/ui.git"
  },
  "bin": {
    "create-ponti-project": "./scripts/create-project.mjs"
  },
  "files": [
    "dist",
    "src/styles/animations.css",
    "scripts/create-project.mjs",
    "templates/web-vite",
    "THIRD_PARTY_NOTICES.md",
    "!dist/styles-build.js",
    "!dist/package-index.d.ts",
    "!dist/storybook/**",
    "!dist/styles/build.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/styles.css",
    "./src/styles/animations.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/components/primitives/index.d.ts",
      "import": "./dist/components/primitives/index.js"
    },
    "./forms": {
      "types": "./dist/components/forms/index.d.ts",
      "import": "./dist/components/forms/index.js"
    },
    "./feedback": {
      "types": "./dist/components/feedback/index.d.ts",
      "import": "./dist/components/feedback/index.js"
    },
    "./filters": {
      "types": "./dist/components/filters/index.d.ts",
      "import": "./dist/components/filters/index.js"
    },
    "./overlays": {
      "types": "./dist/components/overlays/index.d.ts",
      "import": "./dist/components/overlays/index.js"
    },
    "./navigation": {
      "types": "./dist/components/navigation/index.d.ts",
      "import": "./dist/components/navigation/index.js"
    },
    "./data-display": {
      "types": "./dist/components/data-display/index.d.ts",
      "import": "./dist/components/data-display/index.js"
    },
    "./layout": {
      "types": "./dist/components/layout/index.d.ts",
      "import": "./dist/components/layout/index.js"
    },
    "./utilities": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./tokens": {
      "types": "./dist/styles/tokens/index.d.ts",
      "import": "./dist/styles/tokens/index.js"
    },
    "./tokens/css-vars": {
      "types": "./dist/styles/tokens/css-vars.d.ts",
      "import": "./dist/styles/tokens/css-vars.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "react-native": "./dist/native/index.js",
      "import": "./dist/native/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./integrations/service-worker": {
      "types": "./dist/integrations/service-worker.d.ts",
      "import": "./dist/integrations/service-worker.js"
    },
    "./translations": {
      "types": "./dist/translations/ui-provider.d.ts",
      "import": "./dist/translations/ui-provider.js"
    },
    "./styles.css": "./dist/styles.css",
    "./animations.css": "./src/styles/animations.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "check": "make check",
    "build": "make build",
    "test": "make test",
    "storybook": "make storybook",
    "format": "make format",
    "create:project": "node ./scripts/create-project.mjs",
    "build:styles": "vite build --config vite.styles.config.ts",
    "prepack": "pnpm run check"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@base-ui/react": "^1.6.0",
    "@radix-ui/colors": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "10.5.6",
    "@storybook/addon-docs": "10.5.6",
    "@storybook/addon-links": "10.5.6",
    "@storybook/addon-onboarding": "10.5.6",
    "@storybook/addon-themes": "10.5.6",
    "@storybook/addon-vitest": "10.5.6",
    "@storybook/react-vite": "10.5.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "oxfmt": "0.64.0",
    "oxlint": "^1.74.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-native": "0.87.1",
    "storybook": "10.5.6",
    "style-dictionary": "5.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-native": ">=0.80"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.10.0"
}
